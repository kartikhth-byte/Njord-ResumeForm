# Copy this file to .env.playwright and fill in local-only test credentials.

# Recruiter smoke test credentials
PLAYWRIGHT_RECRUITER_EMAIL=
PLAYWRIGHT_RECRUITER_PASSWORD=

# Optional: custom storage state path for applicant Google login
PLAYWRIGHT_APPLICANT_STORAGE_STATE=playwright/.auth/applicant.json

# Optional: set to 1 to refresh the applicant session capture before smoke tests
# PLAYWRIGHT_REFRESH_APPLICANT=1
