# .env.example
# Copy this to .env.local and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy fallback for deployments that have not migrated yet:
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions receive SUPABASE_SECRET_KEYS from Supabase automatically.

# Required for write-capable applicant smoke setup; set to the staging project ref only.
# Production project btbqdviuqcpauojmorvx is denied even if specified here.
PLAYWRIGHT_DRAFT_TEST_PROJECT_REF=your-staging-project-ref

# Application Configuration
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173

# Email Configuration (for future use)
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM=notifications@njordships.com

# Feature Flags (optional)
VITE_ENABLE_AI_SEARCH=true
VITE_ENABLE_TEAM_MANAGEMENT=true
